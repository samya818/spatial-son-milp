# =============================================================================
# WiseNet V1.5 - Variables d'Environnement (CAMARA & Vodafone Sandbox)
# =============================================================================
# Instructions :
# 1. Copier ce fichier et le renommer en '.env'
# 2. Remplacer les valeurs ci-dessous par vos identifiants obtenus en privé.
# NE JAMAIS COMMITER LE FICHIER '.env' CONTENANT DE VRAIES CLES SECRETES.

# Paire 1 : Quality-on-Demand (CAMARA QoD v1.1.0)
CAMARA_CLIENT_ID="votre_consumer_key_qod"
CAMARA_CLIENT_SECRET="votre_consumer_secret_qod"

# Paire 2 : Vodafone Analytics (Realtime Footfall & Reference QuadKey)
VODAFONE_ANALYTICS_CLIENT_ID="votre_consumer_key_footfall"
VODAFONE_ANALYTICS_CLIENT_SECRET="votre_consumer_secret_footfall"

# Paire 3 : Vodafone Device Location Sandbox
VODAFONE_LOCATION_CLIENT_ID="votre_consumer_key_location"
VODAFONE_LOCATION_CLIENT_SECRET="votre_consumer_secret_location"

# Configuration Solver & Logging
SOLVER_NAME="cbc"
LOG_LEVEL="INFO"

